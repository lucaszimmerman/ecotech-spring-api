# Active profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=
DB_USERNAME=user
DB_PASSWORD=senha
# Alternative names accepted in production
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=senha

# JWT
JWT_SECRET=replace-with-a-base64-encoded-secret
JWT_EXPIRATION=3600

# AWS
AWS_REGION=sa-east-1
AWS_S3_BUCKET_NAME=replace-with-your-s3-bucket-name
AWS_SES_FROM_EMAIL=no-reply@example.com

# Optional: used by the AWS SDK when credentials are not provided by IAM role/profile
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key

# Google OAuth2
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Application
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
